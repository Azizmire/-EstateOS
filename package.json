{
  "name": "estateos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "npm run build:client && npm run build:api",
    "build:client": "tsc -b && vite build",
    "build:api": "npm --prefix server run build",
    "test": "npm --prefix server test",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:frontend",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^26.1.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.10"
  }
}
