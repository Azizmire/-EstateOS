generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  MAINTENANCE
  TENANT
  OWNER
}

enum UnitStatus {
  OCCUPIED
  VACANT
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRING
  ENDED
  TERMINATED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  FAILED
  REFUNDED
}

enum PaymentType {
  RENT
  DEPOSIT
  LATE_FEE
  OTHER
}

enum FileCategory {
  PROPERTY_IMAGE
  LEASE_DOCUMENT
  MAINTENANCE_ATTACHMENT
}

enum ExpenseCategory {
  MAINTENANCE
  UTILITIES
  INSURANCE
  TAX
  MANAGEMENT
  CAPITAL_IMPROVEMENT
  OTHER
}

enum NotificationType {
  LEASE_EXPIRING
  PAYMENT_LATE
  MAINTENANCE_UPDATE
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedRequests MaintenanceRequest[] @relation("AssignedTechnician")
  uploadedFiles    FileAsset[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  tenantProfile    Tenant?
  ownedProperties  PropertyOwner[]
  refreshSessions  RefreshSession[]
}

model RefreshSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  rotatedAt DateTime?
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Property {
  id          String   @id @default(cuid())
  name        String
  address1    String
  address2    String?
  city        String
  state       String
  postalCode  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       Unit[]
  maintenance MaintenanceRequest[]
  images      PropertyImage[]
  expenses    Expense[]
  owners      PropertyOwner[]
}

model PropertyOwner {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
}

model Unit {
  id          String     @id @default(cuid())
  propertyId  String
  number      String
  bedrooms    Int
  bathrooms   Decimal    @db.Decimal(3, 1)
  squareFeet  Int?
  marketRent  Decimal    @db.Decimal(10, 2)
  status      UnitStatus @default(VACANT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases      Lease[]
  maintenance MaintenanceRequest[]

  @@unique([propertyId, number])
  @@index([propertyId])
}

model Tenant {
  id               String   @id @default(cuid())
  userId           String?  @unique
  firstName        String
  lastName         String
  email            String   @unique
  phone            String?
  emergencyName    String?
  emergencyPhone   String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leases            LeaseTenant[]
  maintenance       MaintenanceRequest[]
  payments          Payment[]
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Lease {
  id              String      @id @default(cuid())
  unitId          String
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Decimal     @db.Decimal(10, 2)
  securityDeposit Decimal     @db.Decimal(10, 2)
  status          LeaseStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenants         LeaseTenant[]
  payments        Payment[]
  documents       LeaseDocument[]

  @@index([unitId])
  @@index([status])
}

model LeaseTenant {
  leaseId  String
  tenantId String
  primary  Boolean @default(false)

  lease    Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([leaseId, tenantId])
}

model MaintenanceRequest {
  id                   String                @id @default(cuid())
  propertyId           String
  unitId               String?
  tenantId             String?
  assignedTechnicianId String?
  title                String
  description          String
  priority             MaintenancePriority   @default(NORMAL)
  status               MaintenanceStatus     @default(NEW)
  scheduledFor         DateTime?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit                 Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assignedTechnician   User?     @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  updates              MaintenanceUpdate[]
  attachments          MaintenanceAttachment[]

  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([priority])
}

model MaintenanceUpdate {
  id            String   @id @default(cuid())
  requestId     String
  message       String
  status        MaintenanceStatus?
  createdAt     DateTime @default(now())

  request       MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  leaseId     String
  amount      Decimal       @db.Decimal(10, 2)
  type        PaymentType   @default(RENT)
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  paidAt      DateTime?
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease       Lease  @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([leaseId])
  @@index([status])
  @@index([dueDate])
}

model FileAsset {
  id               String       @id @default(cuid())
  uploadedById     String?
  category         FileCategory
  key              String       @unique
  originalFilename String
  mimeType         String
  extension        String
  size             Int
  checksum         String?
  width            Int?
  height           Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  uploadedBy       User?                    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  propertyImage    PropertyImage?
  leaseDocument    LeaseDocument?
  maintenanceFile  MaintenanceAttachment?

  @@index([uploadedById])
  @@index([category])
  @@index([createdAt])
}

model PropertyImage {
  id          String   @id @default(cuid())
  propertyId  String
  fileId      String   @unique
  thumbnailKey String?
  altText     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  file        FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model LeaseDocument {
  id          String   @id @default(cuid())
  leaseId     String
  fileId      String   @unique
  title       String?
  createdAt   DateTime @default(now())

  lease       Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  file        FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([leaseId])
}

model MaintenanceAttachment {
  id          String   @id @default(cuid())
  requestId   String
  fileId      String   @unique
  caption     String?
  createdAt   DateTime @default(now())

  request     MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  file        FileAsset          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Expense {
  id          String          @id @default(cuid())
  propertyId  String?
  category    ExpenseCategory @default(OTHER)
  amount      Decimal         @db.Decimal(10, 2)
  incurredAt  DateTime
  vendor      String?
  description String
  reference   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  property    Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([category])
  @@index([incurredAt])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  dedupeKey  String           @unique
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
