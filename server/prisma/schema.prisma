generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  MAINTENANCE
  TENANT
}

enum UnitStatus {
  OCCUPIED
  VACANT
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRING
  ENDED
  TERMINATED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  FAILED
  REFUNDED
}

enum PaymentType {
  RENT
  DEPOSIT
  LATE_FEE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedRequests MaintenanceRequest[] @relation("AssignedTechnician")
}

model Property {
  id          String   @id @default(cuid())
  name        String
  address1    String
  address2    String?
  city        String
  state       String
  postalCode  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       Unit[]
  maintenance MaintenanceRequest[]
}

model Unit {
  id          String     @id @default(cuid())
  propertyId  String
  number      String
  bedrooms    Int
  bathrooms   Decimal    @db.Decimal(3, 1)
  squareFeet  Int?
  marketRent  Decimal    @db.Decimal(10, 2)
  status      UnitStatus @default(VACANT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases      Lease[]
  maintenance MaintenanceRequest[]

  @@unique([propertyId, number])
  @@index([propertyId])
}

model Tenant {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String   @unique
  phone            String?
  emergencyName    String?
  emergencyPhone   String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leases            LeaseTenant[]
  maintenance       MaintenanceRequest[]
  payments          Payment[]
}

model Lease {
  id              String      @id @default(cuid())
  unitId          String
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Decimal     @db.Decimal(10, 2)
  securityDeposit Decimal     @db.Decimal(10, 2)
  status          LeaseStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenants         LeaseTenant[]
  payments        Payment[]

  @@index([unitId])
  @@index([status])
}

model LeaseTenant {
  leaseId  String
  tenantId String
  primary  Boolean @default(false)

  lease    Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([leaseId, tenantId])
}

model MaintenanceRequest {
  id                   String                @id @default(cuid())
  propertyId           String
  unitId               String?
  tenantId             String?
  assignedTechnicianId String?
  title                String
  description          String
  priority             MaintenancePriority   @default(NORMAL)
  status               MaintenanceStatus     @default(NEW)
  scheduledFor         DateTime?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit                 Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assignedTechnician   User?     @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  updates              MaintenanceUpdate[]

  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([priority])
}

model MaintenanceUpdate {
  id            String   @id @default(cuid())
  requestId     String
  message       String
  status        MaintenanceStatus?
  createdAt     DateTime @default(now())

  request       MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  leaseId     String
  amount      Decimal       @db.Decimal(10, 2)
  type        PaymentType   @default(RENT)
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  paidAt      DateTime?
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease       Lease  @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([leaseId])
  @@index([status])
  @@index([dueDate])
}
